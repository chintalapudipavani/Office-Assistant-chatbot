# ===== Django =====
# Generate a value with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Example: Asia/Kolkata, Europe/London, America/New_York
DJANGO_TIME_ZONE=UTC

# ===== Uploads and chat limits =====
MAX_UPLOAD_SIZE_MB=10
MAX_QUESTION_CHARS=1000
# How many previous messages are sent to the LLM so follow-up questions work
CHAT_HISTORY_MESSAGES=6

# ===== LLM provider (any OpenAI-compatible API) =====
# Option A: OpenAI           -> leave LLM_BASE_URL empty, set LLM_API_KEY, LLM_MODEL (example: gpt-4o-mini)
# Option B: Groq             -> LLM_BASE_URL=https://api.groq.com/openai/v1
# Option C: OpenRouter       -> LLM_BASE_URL=https://openrouter.ai/api/v1
# Option D: Local Ollama     -> LLM_BASE_URL=http://localhost:11434/v1 , LLM_API_KEY=ollama , LLM_MODEL=llama3.2
# Model names change over time: check your provider's current model list.
# Do NOT put quotes around values and do NOT commit this file once it has a real key.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=600

# ===== RAG settings =====
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
# Minimum cosine similarity (0 to 1) for a chunk to count as relevant. Tune in testing.
RETRIEVAL_MIN_SCORE=0.30
